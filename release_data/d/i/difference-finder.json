    "0.0.3": {
        "info": {
            "author": "Jeongsol Kim",
            "author_email": "wjdthf3927@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: MIT License",
                "Operating System :: OS Independent",
