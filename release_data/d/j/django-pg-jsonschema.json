    "0.1.1": {
        "info": {
            "author": "Max Boone",
            "author_email": "m.boone@liacs.leidenuniv.nl",
            "bugtrack_url": null,
            "classifiers": [
                "License :: Other/Proprietary License",
                "Programming Language :: Python :: 3",
