    "0.3.0": {
        "info": {
            "author": "Kyle Kelley",
            "author_email": "rgbkrk@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 2 - Pre-Alpha",
                "Intended Audience :: Developers",
