    "0.1.1": {
        "info": {
            "author": "Pierre Couy",
            "author_email": "contact@pierre-couy.dev",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 2 - Pre-Alpha",
                "Framework :: Django",
