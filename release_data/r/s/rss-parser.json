    "1.0.0": {
        "info": {
            "author": "dhvcc",
            "author_email": "1337kwiz@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Intended Audience :: Developers",
