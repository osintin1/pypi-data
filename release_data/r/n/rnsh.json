    "0.0.7": {
        "info": {
            "author": "acehoss",
            "author_email": "acehoss@acehoss.net",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: MIT License",
                "Programming Language :: Python :: 3",
