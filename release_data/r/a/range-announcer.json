    "1.0.5": {
        "info": {
            "author": "Michael J. Swenson",
            "author_email": "mikswenson@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Environment :: Console",
