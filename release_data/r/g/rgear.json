    "0.2.0": {
        "info": {
            "author": "Mark Sellors",
            "author_email": "github@5vcc.com",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: MIT License",
                "Programming Language :: Python :: 3",
