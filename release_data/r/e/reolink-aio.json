    "0.2.3": {
        "info": {
            "author": "starkillerOG",
            "author_email": "starkiller.og@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Intended Audience :: Developers",
