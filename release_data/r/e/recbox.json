    "0.0.2.post0": {
        "info": {
            "author": "zhujiem",
            "author_email": "zhujiem@users.noreply.github.com",
            "bugtrack_url": null,
            "classifiers": [
                "Intended Audience :: Developers",
                "Intended Audience :: Education",
