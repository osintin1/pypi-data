    "3.0.7": {
        "info": {
            "author": "\u7b80\u5f8b\u7eaf",
            "author_email": "HsiangNianian@outlook.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 3 - Alpha",
