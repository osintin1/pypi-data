    "0.8.1": {
        "info": {
            "author": "Ryan Morshead",
            "author_email": "ryan.morshead@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Environment :: Web Environment",
                "Framework :: AsyncIO",
                "Framework :: Flask",
