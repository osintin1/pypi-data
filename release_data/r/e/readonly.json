    "0.1.2": {
        "info": {
            "author": "Mahmoud Harmouch",
            "author_email": "business@wiseai.dev",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 2 - Pre-Alpha",
                "Intended Audience :: Developers",
