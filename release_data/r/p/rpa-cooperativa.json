        "info": {
            "author": "Edenilson Fernandes dos Santos",
            "author_email": "santoeen@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Intended Audience :: Developers",
