    "0.1.2": {
        "info": {
            "author": "",
            "author_email": "Ipamo <dev@ipamo.net>",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 4 - Beta",
                "License :: OSI Approved :: MIT License",
