    "2023.5.9": {
        "info": {
            "author": "FBGEMM Team",
            "author_email": "packages@pytorch.org",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 4 - Beta",
                "Intended Audience :: Developers",
                "Intended Audience :: Science/Research",
                "License :: OSI Approved :: BSD License",
                "Programming Language :: Python :: 3",
