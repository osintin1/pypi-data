        "info": {
            "author": "",
            "author_email": "Matthew Taylor <matthew.taylor.andre@gmail.com>",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 3 - Alpha",
                "Intended Audience :: Developers",
