    "0.1.1": {
        "info": {
            "author": "Tom Misawa",
            "author_email": "riversun.org@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 3 - Alpha",
                "Intended Audience :: Developers",
