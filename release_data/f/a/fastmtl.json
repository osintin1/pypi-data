    "1.1.0": {
        "info": {
            "author": "Bar\u0131\u015f Deniz Sa\u011flam",
            "author_email": "bdsaglam@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 3 - Alpha",
                "Intended Audience :: Developers",
