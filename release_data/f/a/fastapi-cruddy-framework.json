    "0.0.2": {
        "info": {
            "author": "mdconaway",
            "author_email": "mdconaway@users.noreply.github.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 4 - Beta",
                "Environment :: Web Environment",
                "Framework :: FastAPI",
