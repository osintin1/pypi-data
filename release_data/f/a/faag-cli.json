    "0.0.4.dev0": {
        "info": {
            "author": "Vetrichelvan",
            "author_email": "pythonhubdev@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: MIT License",
                "Operating System :: OS Independent",
