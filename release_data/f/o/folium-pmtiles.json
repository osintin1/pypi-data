    "0.1.1": {
        "info": {
            "author": "Jt Miclat",
            "author_email": "jtmiclat@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: MIT License",
                "Programming Language :: Python :: 3",
