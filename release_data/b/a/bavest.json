    "1.0.1": {
        "info": {
            "author": "William Todt",
            "author_email": "william.todt@bavest.co",
            "bugtrack_url": null,
            "classifiers": [
                "Programming Language :: Python :: 3",
                "Programming Language :: Python :: 3.10",
