    "0.2.0": {
        "info": {
            "author": "Brett Weir",
            "author_email": "brett@brettops.io",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 2 - Pre-Alpha",
                "Environment :: Console",
