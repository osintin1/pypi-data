    "1.4.3": {
        "info": {
            "author": "",
            "author_email": "adelle.goodwin@curtin.edu.au",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 2 - Pre-Alpha",
                "Intended Audience :: Developers",
