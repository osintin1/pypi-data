    "0.2.1": {
        "info": {
            "author": "Firlast",
            "author_email": "firlastinc@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Intended Audience :: Developers",
