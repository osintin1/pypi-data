    "0.4.0": {
        "info": {
            "author": "calamity",
            "author_email": "clmty@vk.com",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: MIT License",
                "Programming Language :: Python :: 3",
