        "info": {
            "author": "OpenXRLab",
            "author_email": "openxrlab@pjlab.org.cn",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 4 - Beta",
                "License :: OSI Approved :: Apache Software License",
                "Operating System :: OS Independent",
                "Programming Language :: Python :: 3",
