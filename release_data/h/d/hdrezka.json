            "classifiers": [
                "Development Status :: 4 - Beta",
                "Environment :: Console",
                "Intended Audience :: End Users/Desktop",
                "Intended Audience :: Information Technology",
                "Intended Audience :: Other Audience",
                "Intended Audience :: Telecommunications Industry",
