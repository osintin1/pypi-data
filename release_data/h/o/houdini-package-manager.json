    "1.0.1": {
        "info": {
            "author": "Ariff Jeff",
            "author_email": "fariffjeff@icloud.com",
            "bugtrack_url": null,
            "classifiers": [
                "Programming Language :: Python :: 3",
                "Programming Language :: Python :: 3.10",
