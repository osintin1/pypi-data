                "last_week": -1
            },
            "home_page": "https://github.com/esiabri/isoCycle",
            "keywords": "Neuroscience,Oscillation,Cycle",
            "license": "CC-BY-NC-SA-4.0",
            "maintainer": "",
            "maintainer_email": "",
            "name": "isoCycle",
            "package_url": "https://pypi.org/project/isoCycle/",
            "platform": null,
            "project_url": "https://pypi.org/project/isoCycle/",
            "project_urls": {
                "Download": "https://github.com/esiabri/isoCycle/archive/refs/tags/0.1.1.tar.gz",
