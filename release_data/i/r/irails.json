    "1.1.1": {
        "info": {
            "author": "Bruce chou",
            "author_email": "smjkzsl@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: Apache Software License",
                "Operating System :: OS Independent",
