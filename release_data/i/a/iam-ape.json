        "info": {
            "author": "Tohar Braun, Orca Security",
            "author_email": "tohar@orca.security",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Intended Audience :: Developers",
