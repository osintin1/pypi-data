    "5.0.2": {
        "info": {
            "author": "\u7b80\u5f8b\u7eaf",
            "author_email": "admin@jyunko.cn",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 3 - Alpha",
                "Environment :: Console",
                "Framework :: AsyncIO",
