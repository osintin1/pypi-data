    "1.2.3": {
        "info": {
            "author": "Kloniphani Maxakadzi",
            "author_email": "Kloniphani@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Intended Audience :: Developers",
