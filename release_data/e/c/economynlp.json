    "0.0.2": {
        "info": {
            "author": "Draco Deng",
            "author_email": "dracodeng6@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Intended Audience :: Developers",
                "License :: OSI Approved :: MIT License",
