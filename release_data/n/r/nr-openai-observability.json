    "0.2.2": {
        "info": {
            "author": "AIR",
            "author_email": "applied-intelligence-research-team@newrelic.com",
            "bugtrack_url": null,
            "classifiers": [
                "Programming Language :: Python :: 3",
                "Programming Language :: Python :: 3.10",
