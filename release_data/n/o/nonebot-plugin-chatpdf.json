    "0.1.0": {
        "info": {
            "author": "Alpaca",
            "author_email": "alpaca@bupt.edu.cn",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: MIT License",
                "Programming Language :: Python :: 3",
