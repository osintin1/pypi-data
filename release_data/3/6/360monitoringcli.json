    "1.0.7": {
        "info": {
            "author": "Jan Loeffler",
            "author_email": "jan.loeffler@webpros.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Environment :: Console",
