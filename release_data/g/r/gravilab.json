    "0.1.1": {
        "info": {
            "author": "Artem Basalaev",
            "author_email": "artemDOTbasalaev@physikDOTuni-hamburg.de",
            "bugtrack_url": null,
            "classifiers": [
                "Programming Language :: Python :: 3",
                "Programming Language :: Python :: 3.10",
