    "0.1.4": {
        "info": {
            "author": "Simon de Vlieger",
            "author_email": "cmdr@supakeen.com",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: MIT License",
                "Programming Language :: Python",
                "Programming Language :: Python :: 3",
