    "0.0.3": {
        "info": {
            "author": "",
            "author_email": "Febri Fahmi Hakim <fahmi_fafa@yahoo.com>, Daru Jaka Sasangka <darujakasasangka@gmail.com>",
            "bugtrack_url": null,
