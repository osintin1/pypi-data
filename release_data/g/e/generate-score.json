    "0.0.2": {
        "info": {
            "author": "",
            "author_email": "Sukmock Lee <smlee@inha.ac.kr>",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 3 - Alpha",
                "Intended Audience :: Education",
