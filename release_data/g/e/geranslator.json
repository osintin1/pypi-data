    "0.1.0": {
        "info": {
            "author": "Faissal Wahabali",
            "author_email": "fwahabali@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 3 - Alpha",
                "License :: OSI Approved :: MIT License",
                "Operating System :: OS Independent",
