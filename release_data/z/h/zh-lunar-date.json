    "0.0.3": {
        "info": {
            "author": "Kylin",
            "author_email": "l1328076914@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: GNU General Public License v3 or later (GPLv3+)",
