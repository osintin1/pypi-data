    "0.1.1": {
        "info": {
            "author": "nowanti",
            "author_email": "believel.y@qq.com",
            "bugtrack_url": null,
            "classifiers": [
                "Programming Language :: Python :: 3",
                "Programming Language :: Python :: 3.10",
