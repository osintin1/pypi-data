    "0.0.3": {
        "info": {
            "author": "Pavel Maksimov",
            "author_email": "vur21@ya.ru",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: Apache Software License",
                "Programming Language :: Python :: 3",
