    "0.1.4": {
        "info": {
            "author": "Shibaji Chakraborty",
            "author_email": "shibaji7@vt.edu",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 3 - Alpha",
                "Intended Audience :: Education",
