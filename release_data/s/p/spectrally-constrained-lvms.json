    "0.1.3": {
        "info": {
            "author": "Ryan Balshaw",
            "author_email": "ryanbalshaw81@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 4 - Beta",
                "License :: OSI Approved :: MIT License",
