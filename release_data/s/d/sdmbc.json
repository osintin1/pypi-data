    "0.1.1": {
        "info": {
            "author": "Youngil Kim",
            "author_email": "youngil.kim@student.unsw.edu.au",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 3 - Alpha",
                "License :: OSI Approved :: MIT License",
                "Programming Language :: Python :: 3",
