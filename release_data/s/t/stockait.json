    "0.0.7": {
        "info": {
            "author": "Eunsu Kim, Sieun Kim, Eunji Cha, Yujin Cha",
            "author_email": "stockai2023@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: MIT License",
                "Operating System :: OS Independent",
                "Programming Language :: Python :: 3"
