    "0.2.1": {
        "info": {
            "author": "Constantine Karos",
            "author_email": "ckaros@outlook.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 2 - Pre-Alpha",
                "Intended Audience :: Developers",
