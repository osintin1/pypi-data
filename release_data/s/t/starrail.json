    "0.0.3": {
        "info": {
            "author": "Kevin L.",
            "author_email": "kevinliu@vt.edu",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 1 - Planning",
                "License :: OSI Approved :: MIT License",
