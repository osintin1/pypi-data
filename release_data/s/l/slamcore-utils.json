    "0.1.6": {
        "info": {
            "author": "Nikos Koukis",
            "author_email": "nikolaos@slamcore.com",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: BSD License",
                "License :: Other/Proprietary License",
                "Operating System :: Unix",
                "Programming Language :: Python :: 3",
                "Programming Language :: Python :: 3.10",
