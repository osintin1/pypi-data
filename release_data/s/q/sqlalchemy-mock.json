    "1.0.2": {
        "info": {
            "author": "ivanostapiuk",
            "author_email": "ost.ivan13@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Programming Language :: Python :: 3",
                "Programming Language :: Python :: 3.10",
                "Programming Language :: Python :: 3.11",
                "Programming Language :: Python :: 3.4",
                "Programming Language :: Python :: 3.5",
