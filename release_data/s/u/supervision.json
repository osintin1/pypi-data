    "0.3.0": {
        "info": {
            "author": "Piotr Skalski",
            "author_email": "piotr.skalski92@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Intended Audience :: Developers",
                "Intended Audience :: Science/Research",
                "License :: OSI Approved :: BSD License",
                "Operating System :: MacOS",
