            "author": "Dylan T. Bespalko",
            "author_email": "dylan.bespalko@me.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Environment :: X11 Applications :: Qt",
