    "1.0.20": {
        "info": {
            "author": "howard",
            "author_email": "18071131140telephone@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: MIT License",
                "Programming Language :: Python",
                "Programming Language :: Python :: 3.0",
                "Programming Language :: Python :: 3.1",
                "Programming Language :: Python :: 3.10",
