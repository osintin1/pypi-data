    "0.1.9": {
        "info": {
            "author": "Jim Chng",
            "author_email": "jimchng@outlook.com",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: MIT License",
                "Programming Language :: Python :: 3",
