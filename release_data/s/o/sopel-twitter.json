    "1.1.0": {
        "info": {
            "author": "dgw",
            "author_email": "dgw@technobabbl.es",
            "bugtrack_url": null,
            "classifiers": [
                "Intended Audience :: Developers",
                "Intended Audience :: System Administrators",
