    "4.1.2": {
        "info": {
            "author": "Roman Sirokov",
            "author_email": "roman@flowrl.com",
            "bugtrack_url": null,
            "classifiers": [
                "Environment :: MacOS X",
                "Environment :: Win32 (MS Windows)",
                "Environment :: X11 Applications :: GTK",
