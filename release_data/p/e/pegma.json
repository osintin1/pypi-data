    "1.0.11": {
        "info": {
            "author": "Digvijay Patankar",
            "author_email": "dbpatankar@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 4 - Beta",
                "Intended Audience :: Science/Research",
