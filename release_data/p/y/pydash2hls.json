    "2.1.2": {
        "info": {
            "author": "hyugogirubato",
            "author_email": "hyugogirubato@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Intended Audience :: Developers",
