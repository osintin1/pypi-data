    "1.2.2": {
        "info": {
            "author": "Wubin Ding",
            "author_email": "Wubin Ding <ding.wu.bin.gm@gmail.com>",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: MIT License",
                "Operating System :: OS Independent",
                "Programming Language :: Python :: 3"
