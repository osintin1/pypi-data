    "0.2.1b0": {
        "info": {
            "author": "Armandt van Zyl",
            "author_email": "armandtvz@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 4 - Beta",
                "Intended Audience :: Developers",
