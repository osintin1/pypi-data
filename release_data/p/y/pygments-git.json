    "1.2.0": {
        "info": {
            "author": "Adam Johnson",
            "author_email": "me@adamj.eu",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Intended Audience :: Developers",
