    "1.0.4": {
        "info": {
            "author": "Rahul Katoch, Harish kumar",
            "author_email": "rahulkatoch99@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
