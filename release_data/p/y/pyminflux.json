    "0.1.2": {
        "info": {
            "author": "Aaron Ponti",
            "author_email": "aaron.ponti@bsse.ethz.ch",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Intended Audience :: Developers",
