    "0.0.3": {
        "info": {
            "author": "Linus Groschke",
            "author_email": "linus@elektronisch.dev",
            "bugtrack_url": null,
            "classifiers": [
                "Intended Audience :: Developers",
                "Operating System :: OS Independent",
                "Programming Language :: Python",
