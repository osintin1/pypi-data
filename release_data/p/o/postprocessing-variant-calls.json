    "0.1.6": {
        "info": {
            "author": "Ronak Shah",
            "author_email": "shahr2@mskcc.org",
            "bugtrack_url": null,
            "classifiers": [
                "Programming Language :: Python :: 3",
                "Programming Language :: Python :: 3.10",
