    "4.2.0a5": {
        "info": {
            "author": "Olivier Delaere",
            "author_email": "olivier.delaere@imio.be",
            "bugtrack_url": null,
            "classifiers": [
                "Environment :: Web Environment",
                "Framework :: Plone",
