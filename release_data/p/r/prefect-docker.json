    "0.2.1": {
        "info": {
            "author": "Prefect Technologies, Inc.",
            "author_email": "help@prefect.io",
            "bugtrack_url": null,
            "classifiers": [
                "Intended Audience :: Developers",
                "Intended Audience :: System Administrators",
