        "info": {
            "author": "recoma",
            "author_email": "seokbong60@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Intended Audience :: Developers",
                "License :: OSI Approved :: GNU General Public License v3 (GPLv3)",
                "Operating System :: Microsoft :: Windows :: Windows 10",
