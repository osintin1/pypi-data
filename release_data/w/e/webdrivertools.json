    "0.0.2": {
        "info": {
            "author": "",
            "author_email": "Leandro Pereira de Lima e Silva <leandro@lls-software.com>",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 4 - Beta",
                "Intended Audience :: Developers",
