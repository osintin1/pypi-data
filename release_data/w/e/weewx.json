    "5.0.0a12": {
        "info": {
            "author": "Tom Keffer",
            "author_email": "tkeffer@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Intended Audience :: End Users/Desktop",
