    "3.4.0": {
        "info": {
            "author": "Xiaoyou Chen",
            "author_email": "xiaoyou.chen@mail.vnpy.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
