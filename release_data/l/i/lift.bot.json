    "15.5.1": {
        "info": {
            "author": ".drmr",
            "author_email": "hi@icey.fr",
            "bugtrack_url": null,
            "classifiers": [
                "Programming Language :: Python",
                "Programming Language :: Python :: 2",
                "Programming Language :: Python :: 2.7",
