    "0.1.1": {
        "info": {
            "author": "34j",
            "author_email": "34j.95a2p@simplelogin.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 2 - Pre-Alpha",
                "Intended Audience :: Developers",
                "License :: OSI Approved :: MIT License",
                "Natural Language :: English",
