    "0.0.2": {
        "info": {
            "author": "Amos Jun-yeung Ng",
            "author_email": "me@amos.ng",
            "bugtrack_url": null,
            "classifiers": [
                "Programming Language :: Python :: 3",
                "Programming Language :: Python :: 3.10"
