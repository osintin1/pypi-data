    "1.0.2": {
        "info": {
            "author": "China Galaxy Securities Co.,Ltd.",
            "author_email": "",
            "bugtrack_url": null,
            "classifiers": [],
            "description": "\u683c\u7269\u673a\u6784\u91d1\u878d\u670d\u52a1\u5e73\u53f0\u4ee5\u591a\u5143\u5e02\u573a\u6570\u636e\u4fe1\u606f\u7684\u6574\u5408\u548c\u4eba\u5de5\u667a\u80fd\u5206\u6790\u4e3a\u57fa\u7840\uff0c\u7ed3\u5408\u4e2d\u56fd\u94f6\u6cb3\u8bc1\u5238\u73b0\u6709\u7684\u6280\u672f\u548c\u4e1a\u52a1\u4f18\u52bf\uff0c\u4f9d\u6258\u5927\u6570\u636e\u3001\u9ad8\u6027\u80fd\u7cfb\u7edf\u3001\u4eba\u5de5\u667a\u80fd\u7b49\u9886\u57df\u7684\u6280\u672f\u79ef\u7d2f\uff0c\u6574\u5408\u591a\u65b9\u6570\u636e\u6765\u6e90\u5f62\u6210\u6807\u51c6\u5316\u6570\u636e\u4f53\u7cfb\uff0c\u5f62\u6210\u96c6\u6570\u636e\u63a5\u5165\u3001\u63a8\u9001\u3001\u67e5\u8be2\u3001\u8ba1\u7b97\u548c\u5206\u6790\u4e3a\u4e00\u4f53\u7684\u6295\u7814\u6570\u636e\u89e3\u51b3\u65b9\u6848\uff0c\u4e3a\u673a\u6784\u548c\u9ad8\u51c0\u503c\u4e2a\u4eba\u7528\u6237\u63d0\u4f9b\u5e02\u573a\u524d\u6cbf\u3001\u53ef\u9760\u3001\u5168\u9762\u3001\u6781\u901f\u7684\u91d1\u878d\u6570\u636e\u670d\u52a1\u3002\n\u652f\u6301\u7684\u6570\u636e\u5305\u62ec\uff1a\n+ \u5b9e\u65f6\u63a8\u9001K\u7ebf\u6570\u636e\uff081/3/5/10/15/30/60/120\u5206\u949f\u7ebf\uff09\n+\tLevel1\u5feb\u7167\u5386\u53f2\u6570\u636e\n+\tK\u7ebf\u5386\u53f2\u6570\u636e\uff08\u65e5/\u5468/\u6708/\u5b63\u5e74\u7ebf\u30011/3/5/10/15/30/60/120\u5206\u949f\u7ebf\uff09\n+\t\u5b9e\u65f6\u63a8\u9001\u5feb\u7167\u884d\u751f\u6307\u6807\u6570\u636e\n+\t\u5b9e\u65f6\u63a8\u9001\u52a0\u5de5\u56e0\u5b50\u6570\u636e\n+\t\u8bc1\u5238\u4e2a\u80a1\u57fa\u672c\u4fe1\u606f\u67e5\u8be2\n+\t\u8bc1\u5238\u4ee3\u7801\u8868\u4fe1\u606f\u67e5\u8be2\n+\t\u590d\u6743\u56e0\u5b50\u8868\u4fe1\u606f\u67e5\u8be2\n+\t\u52a0\u5de5\u56e0\u5b50\u5386\u53f2\u6570\u636e\n+\t\u91d1\u878d\u8d44\u8baf\u6570\u636e\u67e5\u8be2\n+\t\u5b9e\u65f6\u63a8\u9001Level1\u73b0\u8d27\u5feb\u7167\u6570\u636e\n+\t\u5b9e\u65f6\u63a8\u9001\u6307\u6570\u5feb\u7167\u6570\u636e\n+\t\u5b9e\u65f6\u63a8\u9001\u671f\u6743\u5feb\u7167\u6570\u636e\n+\t\u5b9e\u65f6\u63a8\u9001\u671f\u8d27\u5feb\u7167\u6570\u636e\n+\t\u5b9e\u65f6\u63a8\u9001\u6e2f\u80a1\u901a\u5feb\u7167\u6570\u636e\n+\t\u5b9e\u65f6\u63a8\u9001\u76d8\u540e\u5b9a\u4ef7\u4ea4\u6613\u5feb\u7167\u6570\u636e\n+\t\u5b9e\u65f6\u63a8\u9001\u4e2d\u8bc1\u6307\u6570\u5feb\u7167\u6570\u636e\n+\t\u5b9e\u65f6\u63a8\u9001\u6df1\u4ea4\u6240\u56fd\u8bc1\u6307\u6570\u5feb\u7167\u6570\u636e\n+\t\u5b9e\u65f6\u63a8\u9001\u6e2f\u80a1\u901a\u5b9e\u65f6\u989d\u5ea6\u6570\u636e\n+\t\u5b9e\u65f6\u63a8\u9001\u6e2f\u80a1\u901a\u4ea7\u54c1\u72b6\u6001\u5feb\u7167\u6570\u636e\n+\t\u6e2f\u80a1\u5e02\u573a\u6ce2\u52a8\u8c03\u8282\u673a\u5236(VCM)\u63a8\u9001\u6570\u636e\n\n\u8be6\u60c5\u89c1\u4e2d\u56fd\u94f6\u6cb3\u8bc1\u5238\u5b98\u7f51\uff08http://www.chinastock.com.cn/newsite/cgs-services/strategyTrade/geWuInstitution.html\n\n",
