    "2.3.0.dev1": {
        "info": {
            "author": "Avaiga",
            "author_email": "dev@taipy.io",
            "bugtrack_url": null,
            "classifiers": [
                "Intended Audience :: Developers",
                "License :: OSI Approved :: Apache Software License",
                "Natural Language :: English",
                "Programming Language :: Python :: 3",
