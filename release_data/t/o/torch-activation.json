    "0.0.1": {
        "info": {
            "author": "Alan Huynh",
            "author_email": "hdmquan@outlook.com",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: MIT License",
                "Programming Language :: Python :: 3",
