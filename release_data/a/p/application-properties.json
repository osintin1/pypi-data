    "0.7.0": {
        "info": {
            "author": "Jack De Winter",
            "author_email": "jack.de.winter@outlook.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 4 - Beta",
                "Environment :: Console",
