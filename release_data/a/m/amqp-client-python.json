    "0.1.4": {
        "info": {
            "author": "NUTES UEPB",
            "author_email": "dev.seniorsaudemovel@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: Apache Software License",
                "Programming Language :: Python :: 3",
