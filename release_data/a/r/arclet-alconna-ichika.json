    "0.13.3": {
        "info": {
            "author": "",
            "author_email": "RF-Tar-Railt <rf_tar_railt@qq.com>",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 4 - Beta",
                "License :: OSI Approved :: GNU Affero General Public License v3",
                "Operating System :: OS Independent",
                "Programming Language :: Python :: 3.10",
