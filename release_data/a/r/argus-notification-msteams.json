    "0.4": {
        "info": {
            "author": "",
            "author_email": "Hanne Moa <hanne.moa@sikt.no>",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 4 - Beta",
                "Framework :: Django",
                "Framework :: Django :: 3.2",
                "Intended Audience :: Information Technology",
