    "0.0.3.dev0": {
        "info": {
            "author": "Daniel Maroto-Andresen",
            "author_email": "dm937@cam.ac.uk",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 1 - Planning",
                "Environment :: Console",
                "Framework :: Pytest",
                "Framework :: Sphinx",
                "Framework :: tox",
                "Intended Audience :: Developers",
