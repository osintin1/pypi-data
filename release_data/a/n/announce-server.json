    "0.0.2rc0": {
        "info": {
            "author": "Mathematical Michael",
            "author_email": "mm@clfx.cc",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 3 - Alpha",
                "Intended Audience :: Developers",
