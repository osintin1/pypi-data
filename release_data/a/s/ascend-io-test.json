    "0.9.3": {
        "info": {
            "author": "Ascend.io Engineering",
            "author_email": "support@ascend.io",
            "bugtrack_url": null,
            "classifiers": [
                "Intended Audience :: Developers",
                "License :: OSI Approved :: Apache Software License",
