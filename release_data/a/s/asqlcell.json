    "0.1.2": {
        "info": {
            "author": "qizh",
            "author_email": "qizh@datarho.tech",
            "bugtrack_url": null,
            "classifiers": [
                "Framework :: Jupyter",
                "Intended Audience :: Developers",
                "Intended Audience :: Science/Research",
                "License :: OSI Approved :: BSD License",
                "Programming Language :: Python",
