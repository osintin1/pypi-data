    "0.0.5": {
        "info": {
            "author": "Ifeanyi Nneji",
            "author_email": "ifeanyinneji777@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 4 - Beta",
                "Environment :: Console",
                "Intended Audience :: Developers",
                "License :: OSI Approved :: MIT License",
                "Natural Language :: English",
                "Operating System :: OS Independent",
