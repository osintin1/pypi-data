    "0.1.2": {
        "info": {
            "author": "",
            "author_email": "Taika Tech Oy <dev@taikatech.fi>",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 3 - Alpha",
                "Intended Audience :: Developers",
