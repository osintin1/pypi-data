    "0.6.0": {
        "info": {
            "author": "Axiom Data Science",
            "author_email": "kristen@axds.co",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Intended Audience :: Science/Research",
