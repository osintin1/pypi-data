        "info": {
            "author": "Tecnativa, Odoo Community Association (OCA)",
            "author_email": "support@odoo-community.org",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Framework :: Odoo",
                "Framework :: Odoo :: 16.0",
                "License :: OSI Approved :: GNU Affero General Public License v3",
