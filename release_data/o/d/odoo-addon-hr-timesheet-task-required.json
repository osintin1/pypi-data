    "16.0.1.0.0.3": {
        "info": {
            "author": "ACSONE SA/NV, CorporateHub, Odoo Community Association (OCA)",
            "author_email": "support@odoo-community.org",
            "bugtrack_url": null,
            "classifiers": [
