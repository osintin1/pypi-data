    "15.0.1.0.0.9": {
        "info": {
            "author": "Odoo Community Association (OCA), Serpent Consulting Services Pvt. Ltd., Odoo S.A.",
            "author_email": "support@odoo-community.org",
            "bugtrack_url": null,
            "classifiers": [
