        "info": {
            "author": null,
            "author_email": "Aaron Pham <aarnphm@bentoml.com>, BentoML Team <contact@bentoml.com>",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 4 - Beta",
