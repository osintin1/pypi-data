    "0.1.dev149": {
        "info": {
            "author": "Diego Ferigo",
            "author_email": "diego.ferigo@iit.it",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 4 - Beta",
                "Framework :: Robot Framework",
                "Intended Audience :: Developers",
                "Intended Audience :: Science/Research",
