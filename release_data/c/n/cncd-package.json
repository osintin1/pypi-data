d>...</td>\r\n      <td>...</td>\r\n    </tr>\r\n    <tr>\r\n      <th>85</th>\r\n      <td>HZ93</td>\r\n      <td>KHAY BIBI</td>\r\n      <td>1.0</td>\r\n      <td>BIBI</td>\r\n    </tr>\r\n    <tr>\r\n      <th>86</th>\r\n      <td>PZ6</td>\r\n      <td>HUSSAN BIBI</td>\r\n      <td>1.0</td>\r\n      <td>BIBI</td>\r\n    </tr>\r\n    <tr>\r\n      <th>87</th>\r\n      <td>PY27</td>\r\n      <td>NUSRAT BIBI</td>\r\n      <td>1.0</td>\r\n      <td>BIBI</td>\r\n    </tr>\r\n    <tr>\r\n      <th>88</th>\r\n      <td>SM191</td>\r\n      <td>SANGEEDA BB</td>\r\n      <td>1.0</td>\r\n      <td>BB</td>\r\n    </tr>\r\n    <tr>\r\n      <th>89</th>\r\n      <td>RZ9</td>\r\n      <td>SHABANA BIBI</td>\r\n      <td>1.0</td>\r\n      <td>BIBI</td>\r\n    </tr>\r\n  </tbody>\r\n</table>\r\n<p>90 rows \u00c3\u2014 4 columns</p>\r\n</div>\r\n\r\n\r\n\r\n### Check QC status\r\n\r\n\r\n```python\r\nqc.check_qc_status()\r\n```\r\n\r\n\r\n\r\n\r\n<div>\r\n\r\n<table border=\"1\" class=\"dataframe\">\r\n  <thead>\r\n    <tr style=\"text-align: right;\">\r\n      <th></th>\r\n      <th>study_id</th>\r\n      <th>status</th>\r\n      <th>mi</th>\r\n      <th>pre_mi</th>\r\n      <th>st_elevation</th>\r\n      <th>troponin_positive</th>\r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    <tr>\r\n      <th>0</th>\r\n      <td>D1</td>\r\n      <td>1.0</td>\r\n      <td>0.0</td>\r\n      <td>0.0</td>\r\n      <td>1.0</td>\r\n      <td>0.0</td>\r\n    </tr>\r\n    <tr>\r\n      <th>1</th>\r\n      <td>D2</td>\r\n      <td>1.0</td>\r\n      <td>0.0</td>\r\n      <td>0.0</td>\r\n      <td>1.0</td>\r\n      <td>NaN</td>\r\n    </tr>\r\n    <tr>\r\n      <th>2</th>\r\n      <td>D4</td>\r\n      <td>1.0</td>\r\n      <td>0.0</td>\r\n      <td>0.0</td>\r\n      <td>1.0</td>\r\n      <td>0.0</td>\r\n    </tr>\r\n    <tr>\r\n      <th>3</th>\r\n      <td>D5</td>\r\n      <td>1.0</td>\r\n      <td>0.0</td>\r\n      <td>0.0</td>\r\n      <td>1.0</td>\r\n      <td>2.0</td>\r\n    </tr>\r\n    <tr>\r\n    