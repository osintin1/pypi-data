    "2023.1.2": {
        "info": {
            "author": "Ivo Nut\u00e1r",
            "author_email": "nutar@ics.muni.cz",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: MIT License",
                "Programming Language :: Python :: 3",
