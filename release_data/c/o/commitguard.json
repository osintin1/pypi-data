    "2.0.0": {
        "info": {
            "author": "",
            "author_email": "Yasser Tahiri <hello@yezz.me>",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Environment :: Console",
