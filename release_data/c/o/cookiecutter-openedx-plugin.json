    "0.1.3": {
        "info": {
            "author": "Lawrence McDaniel",
            "author_email": "Lawrence McDaniel <lpm0073@gmail.com>",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 3 - Alpha",
                "Framework :: Django",
                "Framework :: Django :: 2.2",
                "Framework :: Django :: 3.0",
                "Framework :: Django :: 3.1",
