    "0.3.2": {
        "info": {
            "author": "The HuggingFace team",
            "author_email": "patrick@huggingface.co",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 5 - Production/Stable",
                "Intended Audience :: Developers",
