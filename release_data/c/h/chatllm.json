    "2023.4.26.9.5.20": {
        "info": {
            "author": "yuanjie",
            "author_email": "313303303@qq.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 2 - Pre-Alpha",
                "Intended Audience :: Developers",
                "License :: OSI Approved :: MIT License",
                "Natural Language :: English",
                "Programming Language :: Python :: 3",
