    "0.2.0": {
        "info": {
            "author": "",
            "author_email": "\"Jose D. Montoya\" <uplot@mailmeto.mozmail.com>",
            "bugtrack_url": null,
            "classifiers": [
                "Intended Audience :: Developers",
