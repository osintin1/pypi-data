    "0.1.2": {
        "info": {
            "author": "Conor Walsh",
            "author_email": "conorwalsh206@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 2 - Pre-Alpha",
                "Intended Audience :: Developers",
