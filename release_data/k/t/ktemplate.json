    "0.3.0": {
        "info": {
            "author": "Kelvin Ng",
            "author_email": "hoishing@gmail.com",
            "bugtrack_url": null,
            "classifiers": [
                "Development Status :: 4 - Beta",
                "Framework :: FastAPI",
                "Framework :: Flask",
                "Intended Audience :: Developers",
                "License :: OSI Approved :: MIT License",
                "Programming Language :: Python :: 3",
