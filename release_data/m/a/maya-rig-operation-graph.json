    "0.2.3": {
        "info": {
            "author": "('cpcgskill',)",
            "author_email": "cpcgskill@outlook.com",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: Apache Software License",
                "Programming Language :: Python",
                "Programming Language :: Python :: 2",
                "Programming Language :: Python :: 2.7",
