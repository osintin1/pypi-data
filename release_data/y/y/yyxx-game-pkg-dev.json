    "2023.3.6.1.dev7": {
        "info": {
            "author": "yyxx-game",
            "author_email": "",
            "bugtrack_url": null,
            "classifiers": [
                "License :: OSI Approved :: MIT License",
                "Operating System :: OS Independent",
